# Copie para .env e ajuste. NUNCA faça commit do .env.

# ---------------- LLM (escolha um provedor com suporte a Tool Calling) ----------------
# ollama | groq | gemini | openrouter | openai (OpenAI ou endpoint compatível: LocalAI, LM Studio...)
LLM_PROVIDER=ollama
LLM_MODEL=qwen2.5:7b
# Exemplos:
#   LLM_PROVIDER=groq        LLM_MODEL=llama-3.3-70b-versatile
#   LLM_PROVIDER=gemini      LLM_MODEL=gemini-2.5-flash
#   LLM_PROVIDER=openrouter  LLM_MODEL=meta-llama/llama-3.3-70b-instruct:free
LLM_API_KEY=
# Opcional: URL do servidor (Ollama remoto, LocalAI, LM Studio...)
LLM_BASE_URL=
LLM_TEMPERATURE=0
LLM_TIMEOUT_S=120
# Só Ollama: janela de contexto. Sem limite, o Ollama usa o máximo do modelo e pode ocupar dezenas de GB de RAM.
LLM_NUM_CTX=8192
# Tentativas extras em 429 / timeout / 5xx (backoff exponencial)
LLM_MAX_RETRIES=3
# llm = with_structured_output + fallback determinístico | deterministico = sem chamada extra ao LLM
STRUCTURED_OUTPUT_MODE=llm

# ---------------- Embeddings (os MESMOS na indexação e na consulta) ----------------
# fastembed (local, CPU, sem conta) | ollama | gemini
EMBEDDING_PROVIDER=ollama
EMBEDDING_MODEL=bge-m3
#   EMBEDDING_PROVIDER=fastembed  EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-mpnet-base-v2
#   EMBEDDING_PROVIDER=gemini     EMBEDDING_MODEL=models/text-embedding-004
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=

# ---------------- Vector store: Qdrant ----------------
# Sem QDRANT_URL -> Qdrant embedded em disco (sem servidor/Docker)
QDRANT_PATH=
# Qdrant em Docker (http://localhost:6333) ou Qdrant Cloud (https://xxxx.cloud.qdrant.io)
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_COLLECTION=normas_academicas

# ---------------- RAG / grafo ----------------
RAG_TOP_K=3
# Similaridade mínima (cosseno) para uma evidência ser aceita. Calibre com: python -m agente.avaliar_retrieval
RAG_SCORE_MIN=0.45
MAX_RODADAS=4
MAX_CHARS_ENTRADA=2000

# ---------------- Logs ----------------
LOG_CONSOLE=false

# ---------------- Chaves usadas só pela comparação de modelos (agente.comparar_modelos) ----------------
GROQ_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=
